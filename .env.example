# Bot token from https://discord.com/developers/applications (Bot tab).
# Required.
DISCORD_TOKEN=your-token-here

# User-facing server ID (where /get and /search are issued).
# Enable Discord "Developer Mode" to right-click a server icon and copy its ID.
TARGET_GUILD_ID=0

# Source server(s) where Mega.nz links are posted. The bot must be a member of
# every listed guild. Comma-separate multiple IDs.
# Example (one guild):  SOURCE_GUILD_IDS=934093322190979072
# Example (multi):      SOURCE_GUILD_IDS=934093322190979072,123456789012345678
# Leaving this empty (= no allow-list) accepts messages from any guild whose
# channels are configured in SOURCE_CHANNELS. Use the allow-list if you want
# to explicitly gate which servers contribute Mega links to your index.
SOURCE_GUILD_IDS=934093322190979072

# Back-compat: SOURCE_GUILD_ID (singular) still loads and is treated as a
# one-element list. Prefer SOURCE_GUILD_IDS. Leave blank in new configs.
SOURCE_GUILD_ID=

# Comma-separated list of channel IDs (across the source guilds above) to
# index for Mega links. May also be added at runtime via /admin link_channel.
SOURCE_CHANNELS=1507994051276832778

# Optional: name of a role in TARGET_GUILD_ID that may use the bot.
# Leave blank for "anyone in the guild".
ALLOWED_ROLE_NAME=

# Comma-separated Discord user IDs (yourself + trusted mods) who can use admin
# commands like /admin reseed, /admin stats, /admin delete_entry.
ADMIN_USER_IDS=0

# SQLite file path (relative to where you run the bot, or absolute).
DATABASE_PATH=data/bot.sqlite

# Path to schema.sql (relative to project root).
SCHEMA_PATH=schema.sql

# Per-user cooldown (seconds) for /get and /search to discourage scraping.
COOLDOWN_SECONDS=5

# Max results per /search page.
SEARCH_PAGE_SIZE=10

# Set to "true" to enable periodic Mega link staleness checks (HEAD request).
# NOTE: Mega aggressively blocks automated HEAD probes. Leave false unless you
# know what you're doing.
MEGA_STALENESS_CHECK=false

# Disable-limit for /search candidates (upper bound for fuzzy ranking).
FUZZY_CANDIDATE_LIMIT=80
